<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows installer, built from the PyInstaller output.

  Unsigned. That does not stop it installing, but SmartScreen will show
  "Windows protected your PC" and the reader has to choose More info → Run
  anyway. A code signing certificate removes that; nothing else does.

  The whole application directory is taken as it stands, rather than each file
  being listed: a PyInstaller bundle is a few thousand files and no hand-kept
  list survives a dependency change.

  Build with WiX 5, installed as a dotnet tool. Pinned: WiX 7 refuses to run
  without accepting a paid maintenance-fee EULA.

      dotnet tool install wix -g ; version 5.0.2
      wix build packaging/milq.wxs -d Version=0.5.1 -b dist -o MIL-Q.msi

  (written without a double hyphen anywhere: XML forbids one inside a comment,
  and WiX reports it as an invalid source file rather than a comment problem)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="MIL-Q"
           Manufacturer="MIL-Q"
           Version="$(Version)"
           UpgradeCode="9f2a5c41-3d7e-4a19-bf62-0c8d1e4a7b53"
           Scope="perUser"
           Compressed="yes">

    <!-- an upgrade replaces the previous version rather than sitting beside it -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of MIL-Q is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- the executable carries the icon for Explorer and the taskbar; the
         Start menu entry and Add or remove programs are told separately.
         IconFile is passed in as an absolute path: a relative SourceFile
         resolves against the working directory, not against this file, and
         WIX0103 "cannot find the Icon file" was the first build's answer. -->
    <Icon Id="MilqIcon" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="MilqIcon" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="MIL-Q" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="MIL-Q" />
    </StandardDirectory>

    <Feature Id="Main" Title="MIL-Q" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>

    <!-- BundleDir is passed in as an absolute path. A relative one resolves
         against this file's own directory, not against the bind path, so
         "MIL-Q\**" quietly matched nothing and produced a 36 KB installer
         that WiX reported as a success. -->
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(BundleDir)\**" />
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts" Directory="ShortcutFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="MilqShortcut"
                  Name="MIL-Q"
                  Target="[INSTALLFOLDER]MIL-Q.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="MilqIcon" />
        <RemoveFolder Id="RemoveShortcutFolder" Directory="ShortcutFolder"
                      On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\MIL-Q"
                       Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Package>
</Wix>
